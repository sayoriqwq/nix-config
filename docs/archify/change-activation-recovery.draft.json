{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "变更应用与恢复流程",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "normal",
      "label": "准备与审阅"
    },
    {
      "id": "apply",
      "label": "应用、验收与候选修复"
    },
    {
      "id": "exceptions",
      "label": "运行恢复",
      "variant": "exception"
    }
  ],
  "nodes": [
    {
      "id": "prepare",
      "lane": "normal",
      "col": 0,
      "type": "frontend",
      "label": "核实现场与目标",
      "sublabel": "保存受管字段修改 · 确认恢复入口",
      "width": 160
    },
    {
      "id": "change",
      "lane": "normal",
      "col": 1,
      "type": "backend",
      "label": "准备候选",
      "sublabel": "修改声明 · 按需更新所选输入",
      "width": 160
    },
    {
      "id": "build",
      "lane": "normal",
      "col": 2,
      "type": "backend",
      "label": "验证并构建",
      "sublabel": "相关检查 · 对应主机 closure",
      "width": 160
    },
    {
      "id": "accept",
      "lane": "normal",
      "col": 3,
      "type": "security",
      "label": "审阅并接受",
      "sublabel": "检查源码 / lock / 包差异 · 提交",
      "width": 160
    },
    {
      "id": "switch",
      "lane": "normal",
      "col": 4,
      "type": "security",
      "label": "授权范围内应用",
      "sublabel": "同一候选 · switch 不再更新输入",
      "width": 160
    },
    {
      "id": "verify",
      "lane": "apply",
      "col": 4,
      "type": "frontend",
      "label": "现场验收",
      "sublabel": "实际功能与状态回读 · 保留恢复点",
      "width": 160
    },
    {
      "id": "fix",
      "lane": "apply",
      "col": 2,
      "type": "security",
      "label": "停止晋升 · 修复候选",
      "sublabel": "构建失败也可能已改 lock",
      "width": 160
    },
    {
      "id": "rollback",
      "lane": "exceptions",
      "col": 3,
      "type": "messagebus",
      "label": "恢复已知可用代际",
      "sublabel": "核实身份与授权 · 保留访问通道",
      "width": 160
    },
    {
      "id": "reconcile",
      "lane": "exceptions",
      "col": 2,
      "type": "backend",
      "label": "修正 Git 声明",
      "sublabel": "运行恢复不会自动修复仓库",
      "width": 160
    },
    {
      "id": "external",
      "lane": "exceptions",
      "col": 4,
      "type": "database",
      "label": "核对外部状态",
      "sublabel": "偏好 / 原生应用 / 数据独立恢复",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "prepare-change",
      "from": "prepare",
      "to": "change",
      "label": "保存选择",
      "role": "main"
    },
    {
      "id": "change-build",
      "from": "change",
      "to": "build",
      "label": "固定候选",
      "role": "main"
    },
    {
      "id": "build-accept",
      "from": "build",
      "to": "accept",
      "label": "通过",
      "role": "main"
    },
    {
      "id": "accept-switch",
      "from": "accept",
      "to": "switch",
      "label": "目标与动作明确",
      "role": "main"
    },
    {
      "id": "switch-verify",
      "from": "switch",
      "to": "verify",
      "label": "应用后",
      "role": "main"
    },
    {
      "id": "build-fix",
      "from": "build",
      "to": "fix",
      "label": "失败",
      "role": "error"
    },
    {
      "id": "fix-change",
      "from": "fix",
      "to": "change",
      "label": "修复后重验",
      "role": "return"
    },
    {
      "id": "verify-rollback",
      "from": "verify",
      "to": "rollback",
      "label": "验收失败",
      "role": "error"
    },
    {
      "id": "rollback-reconcile",
      "from": "rollback",
      "to": "reconcile",
      "label": "修正失败声明",
      "role": "branch"
    },
    {
      "id": "rollback-external",
      "from": "rollback",
      "to": "external",
      "label": "分别核对",
      "role": "branch"
    }
  ],
  "mainPath": [
    "prepare",
    "change",
    "build",
    "accept",
    "switch",
    "verify"
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "操作手册是流程来源",
      "items": [
        "依据 docs/runbooks/daily-nix-maintenance.md 与 nixbox-desktop-recovery.md；按改动选择验证范围。",
        "NixOS test 只临时切换运行系统；switch 还更新 profile 与启动默认项。构建本身不激活。"
      ]
    },
    {
      "dot": "amber",
      "title": "恢复后的验收不能省略",
      "items": [
        "恢复后重新回读实际功能；Git、generation、应用数据各有恢复机制，不能相互替代。",
        "Server 访问失效按 server-recovery.md 升级到控制台；Rescue / 重装另需现场授权与备份。"
      ]
    }
  ]
}
