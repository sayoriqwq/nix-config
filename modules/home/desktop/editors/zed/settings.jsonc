// Zed settings baseline. Live settings remain writable and are never
// overwritten by Home Manager after initialization.
{
  "auto_update": false,
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "helix_mode": true,
  "vim_mode": false,
  "terminal": {
    "font_size": 12.0,
    "font_family": "Maple Mono NF CN",
    "blinking": "on"
  },
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": false,
    "auto_fold_dirs": false
  },
  "base_keymap": "VSCode",
  "tab_bar": {
    "show_tab_bar_buttons": false
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false
    }
  },
  "cursor_blink": true,
  "buffer_font_family": "Maple Mono NF CN",
  "auto_indent_on_paste": false,
  "linked_edits": true,
  "show_whitespaces": "trailing",
  "indent_guides": {
    "enabled": false
  },
  "soft_wrap": "none",
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Ayu Darker"
  }
}
